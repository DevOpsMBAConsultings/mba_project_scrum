<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_project_cronograma_paperformat" model="report.paperformat">
        <field name="name">Cronograma A4 Horizontal</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_project_cronograma" model="ir.actions.report">
        <field name="name">Cronograma de Implementación</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mba_project_scrum.report_project_cronograma</field>
        <field name="report_file">mba_project_scrum.report_project_cronograma</field>
        <field name="paperformat_id" ref="report_project_cronograma_paperformat"/>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_project_cronograma">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc._cronograma_data()"/>
                <t t-set="semanas" t-value="data['semanas']"/>
                <div class="page" style="font-family: Arial, sans-serif; font-size: 9pt; color: #000; padding: 0 15px 15px 15px;">

                    <table style="width: 100%; margin-bottom: 15px; border-collapse: collapse; border: none;">
                        <tr>
                            <td style="width: 34%; vertical-align: middle; border: none;">
                                <t t-if="doc.company_id.logo and not doc.company_id.uses_default_logo">
                                    <img t-att-src="image_data_uri(doc.company_id.logo)"
                                         style="max-height: 90px; max-width: 280px; width: auto;" alt="Logo"/>
                                </t>
                                <t t-else="">
                                    <img src="/formato_cotizacion/static/src/img/logo.png"
                                         style="max-height: 90px; max-width: 280px; width: auto;" alt="Logo"/>
                                </t>
                            </td>
                            <td style="vertical-align: middle; padding-left: 15px; border: none;">
                                <h1 style="font-size: 15pt; color: #0a3d62; margin: 0 0 4px 0;"><span t-field="doc.name"/></h1>
                                <div style="font-size: 11pt; color: #0a3d62;">Cronograma de Implementación</div>
                            </td>
                        </tr>
                    </table>

                    <table class="table table-borderless" style="border-collapse: collapse; width: 100%;">
                        <thead>
                            <tr style="background-color: #0a3d62;">
                                <th style="padding: 6px; color: white; width: 30%; text-align: left;">Sprint</th>
                                <t t-foreach="semanas" t-as="s">
                                    <th style="padding: 6px; color: white; text-align: center;">
                                        <div t-esc="s['label']"/>
                                        <div t-if="s['inicio']" style="font-weight: normal; font-size: 8pt;"
                                             t-esc="s['inicio'].strftime('%d/%m')"/>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data['fases']" t-as="f">
                                <td style="padding: 6px; vertical-align: top;">
                                    <span t-esc="f['name']"/>
                                </td>
                                <t t-foreach="semanas" t-as="s">
                                    <td style="padding: 4px;">
                                        <div t-if="f['col_start'] is not None and f['col_start'] &lt;= s_index and s_index &lt;= f['col_end']"
                                             style="height: 12px; background-color: #0a3d62; border-radius: 3px; position: relative;">
                                            <span t-if="s_index in data['hito_cols']"
                                                  style="position: absolute; right: -4px; top: -3px; color: #0a3d62; font-size: 16px;">&#9670;</span>
                                        </div>
                                    </td>
                                </t>
                            </tr>
                        </tbody>
                    </table>

                    <h3 t-if="data['hitos']" style="font-size: 12pt; color: #0a3d62; margin-top: 20px;">Hitos</h3>
                    <table class="table table-borderless" t-if="data['hitos']" style="border-collapse: collapse; width: 100%;">
                        <thead>
                            <tr style="background-color: #0a3d62;">
                                <th style="padding: 6px; color: white; text-align: left;">Hito</th>
                                <th style="padding: 6px; color: white; text-align: left;">Fecha</th>
                                <th style="padding: 6px; color: white; text-align: left;">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data['hitos']" t-as="h">
                                <td style="padding: 5px;"><span t-esc="h['name']"/></td>
                                <td style="padding: 5px;"><span t-esc="h['deadline'] and h['deadline'].strftime('%d/%m/%Y')"/></td>
                                <td style="padding: 5px;"><span t-esc="h['estado']"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h3 t-if="data['fases']" style="font-size: 12pt; color: #0a3d62; margin-top: 20px; page-break-before: always;">Detalle por Sprint</h3>
                    <t t-foreach="data['fases']" t-as="f">
                        <div style="margin-bottom: 8px;">
                            <div style="font-weight: bold; color: #0a3d62;"><span t-esc="f['name']"/></div>
                            <ul t-if="f['subtasks']" style="margin: 2px 0 0 16px; padding: 0;">
                                <li t-foreach="f['subtasks']" t-as="st" style="margin-bottom: 1px;"><span t-esc="st"/></li>
                            </ul>
                        </div>
                    </t>

                    <div class="footer" style="margin-top: 25px; padding-top: 8px; border-top: 1px solid #ccc; font-size: 8pt; color: #444; text-align: center; line-height: 1.4;">
                        <strong>MBA Consultings</strong> ·
                        <span t-if="doc.company_id.vat">RUC: <span t-field="doc.company_id.vat"/> · </span>
                        <span>Tel: +507 6708-2995 · </span>
                        <span t-if="doc.company_id.email"><span t-field="doc.company_id.email"/> · </span>
                        <span t-if="doc.company_id.website"><span t-field="doc.company_id.website"/></span>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
